# 本机数据服务配置模板。复制到 server/.env 并填入真实值（.env 已被 gitignore）
# 全部可省略，以下为默认值

PORT=8791
HOST=127.0.0.1                # 只读本机；如需局域网访问再改
# DB_PATH=                    # sqlite 主库路径（默认 <仓库>/data/stockdesk.db）
# INGEST_TOKEN=               # /ingest 写入鉴权令牌（与 jobs/sync_data.py 的 cloud_sync.json token 一致）

# 遗留兼容：过渡期双活转发到旧云端 ingest；留空 = 纯本地（当前默认）
# FORWARD_URL=
# FORWARD_TOKEN=
