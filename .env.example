# 复制为 .env 并填入真实值（.env 已被 gitignore，绝不上传）
# AI 模型密钥（pi coding agent providers）
KIMI_API_KEY=
OPENCODE_API_KEY=

# 本地 HTTP 服务器 Bearer 令牌（server.js）
AI_TOKEN=

# CloudBase 环境 ID 与管理 API Key（worker.js 中转写入 ai_replies/ai_requests）
TCB_ENV=ljx-d1gjpcu23fa094e67
CB_API_KEY=

# 可选：专家 skill 目录（默认使用仓库内 ./skill）
# SKILL_BASE=/path/to/your/skills

# ---- 本地数据服务（server/data_service.py）----
# INGEST_TOKEN=             # /ingest 鉴权令牌（与 115 cloud_sync.json token 一致）
# DB_PATH=                  # sqlite 主库路径（默认 repo/data/stockdesk.db）
# FORWARD_URL=              # 过渡期双活：CloudBase ingest 地址；清空=纯本地
# FORWARD_TOKEN=            # 转发令牌（默认同 INGEST_TOKEN）
# LOCAL_DB_BASE=            # worker 队列基址（默认 http://127.0.0.1:8791；可切回云端网关）
